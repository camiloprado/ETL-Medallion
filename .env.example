# Copy to `.env` for local (non-Compose) runs. Compose uses the same defaults.

# BrasilAPI — public, no key required
BRASILAPI_BASE_URL=https://brasilapi.com.br
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3

# Local data lake (bronze JSON + silver Parquet)
DATA_DIR=./data

# Optional: freeze the partition date (YYYY-MM-DD). Empty = today (UTC).
INGEST_DATE=

# Gold warehouse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=br_open_data
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline
POSTGRES_SSLMODE=disable
